DATABASE_URL=postgresql://bloggy:bloggy@localhost:5432/bloggy
PORT=3030
NODE_ENV=development
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=7d
# Comma-separated browser origins (required for Docker / production)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Backend Docker Compose database settings
# URL-encode special characters in POSTGRES_PASSWORD for DATABASE_URL.
POSTGRES_USER=bloggy
POSTGRES_PASSWORD=bloggy
POSTGRES_DB=bloggy
POSTGRES_PORT=5432
