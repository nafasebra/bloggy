DATABASE_URL=postgresql://bloggy:bloggy@localhost:5433/bloggy
PORT=3030
NODE_ENV=development
METRICS_ENABLED=false
METRICS_PORT=9464
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=7d

# Sentry placeholders (SDK integration is not enabled)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
# Comma-separated browser origins (required for Docker / production)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Docker Compose settings belong in the repository-root .env.
# Copy ../.env.docker.example to ../.env for the container stack.
