DATABASE_URL=postgresql://bloggy:bloggy@localhost:5433/bloggy
PORT=3030
NODE_ENV=development
METRICS_ENABLED=false
METRICS_PORT=9464
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=7d

# Host-run backend -> Docker MinIO. Match root .env credentials.
# Inside Compose the backend uses http://minio:9000 instead.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=bloggy-minio
MINIO_SECRET_KEY=change-me-minio-password
MINIO_BUCKET=profile-photos
MINIO_REGION=us-east-1

# Sentry placeholders (SDK integration is not enabled)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=

# Optional Flipt server. Empty URL disables remote evaluation (flags default off).
# Start Docker with --profile flags, then use http://localhost:8080 locally.
FLIPT_URL=
FLIPT_ENVIRONMENT=default
FLIPT_NAMESPACE=default
FLIPT_TOKEN=
# Comma-separated browser origins (required for Docker / production)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Docker Compose settings belong in the repository-root .env.
# Copy ../.env.docker.example to ../.env for the container stack.
