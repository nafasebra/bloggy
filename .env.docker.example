# Copy to .env in the repo root for docker compose.
# Keep JWT_SECRET identical across backend and web.

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Frontend build targets
WEB_APP=web
DASHBOARD_APP=dashboard

# Server-to-server URL inside the Docker Compose network
API_URL=http://backend:3030

# Browser-facing URLs (used for CORS and frontend build args)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3001
VITE_API_URL=http://localhost:3030
VITE_WEB_URL=http://localhost:3000

# PostgreSQL credentials (URL-encode special characters in passwords)
POSTGRES_USER=bloggy
POSTGRES_PASSWORD=bloggy
POSTGRES_DB=bloggy
POSTGRES_PORT=5433

# Backend host port; the application listens on 3030 inside Docker.
PORT=3030

# Browser-based database UI, running inside Docker
PGADMIN_DEFAULT_EMAIL=admin@bloggy.com
PGADMIN_DEFAULT_PASSWORD=change-me-now
PGADMIN_PORT=5050

# Optional monitoring profile
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-now
GRAFANA_PORT=3002
PROMETHEUS_PORT=9090

# k6 is invoked explicitly, not with the normal application stack.
K6_TEST=load
K6_BASE_URL=http://backend:3030
K6_RUN_ID=local
