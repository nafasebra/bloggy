{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "API_URL",
    "JWT_SECRET",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_DASHBOARD_URL",
    "VITE_API_URL",
    "VITE_WEB_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "API_URL",
        "JWT_SECRET",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_DASHBOARD_URL",
        "VITE_API_URL",
        "VITE_WEB_URL"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
