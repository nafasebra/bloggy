# Backend API URL (used by server-side routes and Next.js rewrites)
API_URL=http://localhost:3030

# Must match backend JWT_SECRET (used by proxy for session verification)
JWT_SECRET=your-secret-key-here

# Public URLs
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sentry browser placeholders (public; SDK integration is not enabled)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_RELEASE=

# Sentry server placeholders
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
